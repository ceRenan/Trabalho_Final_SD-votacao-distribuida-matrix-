# Configuracao para conectar o Bot de Votacao ao servidor Matrix do DC/UFC (ou matrix.org)
# Execute `python setup_real_matrix.py` para gerar o arquivo `.env` automaticamente.

MATRIX_HOMESERVER=https://matrix.dc.ufc.br
MATRIX_USER=@seu_usuario:matrix.dc.ufc.br
MATRIX_PASSWORD=
MATRIX_ACCESS_TOKEN=syt_cole_seu_token_aqui
MATRIX_ROOM_ID=!id_da_sala:matrix.dc.ufc.br

# Politica padrao de concorrencia de votos: CHANGE_ALLOWED (Last-Write-Wins) ou STRICT_ONCE
DEFAULT_POLL_POLICY=CHANGE_ALLOWED
NATIVE_POLLS=true
